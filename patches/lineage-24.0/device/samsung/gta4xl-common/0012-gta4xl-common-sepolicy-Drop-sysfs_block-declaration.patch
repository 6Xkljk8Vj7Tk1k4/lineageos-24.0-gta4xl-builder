From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 6Xkljk8Vj7Tk1k4 <6Xkljk8Vj7Tk1k4@users.noreply.github.com>
Date: Wed, 21 Oct 2026 01:53:11 +0000
Subject: [PATCH] gta4xl-common: sepolicy: Drop sysfs_block declaration

Android 17 declares sysfs_block in system/sepolicy/public/file.te
again, so checkpolicy fails on our vendor declaration with "Duplicate
declaration of type". The platform type only gets read access, same as
before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I4e8f7d4ab06dcb65fe6683ca82f4cc0f30665752
---
 sepolicy/vendor/file.te | 1 -
 1 file changed, 1 deletion(-)

diff --git a/sepolicy/vendor/file.te b/sepolicy/vendor/file.te
index fc84e92..2ea15cc 100644
--- a/sepolicy/vendor/file.te
+++ b/sepolicy/vendor/file.te
@@ -19,7 +19,6 @@ type proc_swappiness, fs_type, proc_type;
 
 # sysfs types
 type sysfs_audio, sysfs_type, r_fs_type, fs_type;
-type sysfs_block, sysfs_type, r_fs_type, fs_type;
 type sysfs_block_writable, sysfs_type, rw_fs_type, fs_type;
 type sysfs_camera, sysfs_type, r_fs_type, fs_type;
 type sysfs_camera_writable, sysfs_type, rw_fs_type, fs_type;
