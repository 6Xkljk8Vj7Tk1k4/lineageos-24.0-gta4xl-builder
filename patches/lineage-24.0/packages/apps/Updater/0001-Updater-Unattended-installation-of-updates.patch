+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.updater.autoinstall
+
+import org.lineageos.updater.data.Update
+import java.time.Duration
+import java.time.LocalDateTime
+
+/**
+ * The rules of unattended installation as pure functions: every input is a parameter, nothing
+ * here reads the device, so each rule can be checked on its own.
+ */
+object AutoInstallPolicy {
+    /** Night window in the device's time zone, [start, end); it may wrap past midnight. */
+    const val NIGHT_START_HOUR = 0
+    const val NIGHT_END_HOUR = 5
+
+    /** Free space that must remain after everything still to be written. */
+    const val RESERVE_BYTES = 256L * 1024 * 1024
+
+    /** Delays before resuming a failed download: 30 min, 1, 2, 4, 8 h, then stop. */
+    private val FIRST_DOWNLOAD_RETRY: Duration = Duration.ofMinutes(30)
+    const val MAX_DOWNLOAD_RETRIES = 5
+
+    /** Rule 1: only with the property set, and only on non-A/B devices. */
+    fun isEnabled(propertySet: Boolean, isABDevice: Boolean) = propertySet && !isABDevice
+
+    /** The candidate for automatic installation, or the reason why there is none. */
+    data class Pick(val update: Update?, val reason: String?)
+
+    /**
+     * Rules 3 and 4 at index level. Only the newest eligible update (from the server, not a
+     * local import, newer than the running build, same Android version) can be the candidate;
+     * when it was tried automatically before there is no candidate, never an older build.
+     */
+    fun pickCandidate(
+        updates: List<Update>,
+        buildTimestamp: Long,
+        sdkLevel: Int,
+        attemptedIds: Set<String>,
+    ): Pick {
+        val newest = updates
+            .filter {
+                it.downloadId != Update.LOCAL_ID &&
+                        it.downloadUrl != null &&
+                        it.timestamp > buildTimestamp &&
+                        it.osSdkLevel == sdkLevel
+            }
+            .maxByOrNull { it.timestamp }
+            ?: return Pick(null, "no newer update of this Android version")
+        if (newest.downloadId in attemptedIds) {
+            return Pick(null, "${newest.name} was already tried automatically")
+        }
+        return Pick(newest, null)
+    }
+
+    /**
+     * Rule 3 on the verified package's own signed metadata: newer build, same Android version,
+     * non-A/B package. Returns the reason for refusing, or null when it may be installed.
+     */
+    fun refuseByMetadata(
+        packageTimestamp: Long,
+        packageSdkLevel: Int,
+        packageIsAB: Boolean,
+        buildTimestamp: Long,
+        sdkLevel: Int,
+    ): String? = when {
+        packageIsAB -> "package is A/B"
+        packageTimestamp <= buildTimestamp ->
+            "package build $packageTimestamp is not newer than the running $buildTimestamp"
+        packageSdkLevel != sdkLevel -> "package is for SDK $packageSdkLevel, running $sdkLevel"
+        else -> null
+    }
+
+    fun isNight(hour: Int) = if (NIGHT_START_HOUR <= NIGHT_END_HOUR) {
+        hour >= NIGHT_START_HOUR && hour < NIGHT_END_HOUR
+    } else {
+        hour >= NIGHT_START_HOUR || hour < NIGHT_END_HOUR
+    }
+
+    /** Zero inside the night window, otherwise the time until it next opens. */
+    fun delayToNight(now: LocalDateTime): Duration {
+        if (isNight(now.hour)) return Duration.ZERO
+        var start = now.toLocalDate().atTime(NIGHT_START_HOUR, 0)
+        if (!start.isAfter(now)) start = start.plusDays(1)
+        return Duration.between(now, start)
+    }
+
+    /**
+     * Download errors in a row (1 = the first failure) to the delay before resuming, or null
+     * after [MAX_DOWNLOAD_RETRIES] retries: then the next update check starts again.
+     */
+    fun downloadRetryDelay(failures: Int): Duration? =
+        if (failures in 1..MAX_DOWNLOAD_RETRIES) {
+            FIRST_DOWNLOAD_RETRY.multipliedBy(1L shl (failures - 1))
+        } else {
+            null
+        }
+
+    /**
+     * Rule 7: bytes that must be free before acting: the rest of the download, a second copy
+     * of the package when the file is encrypted (UpdateInstaller copies it for uncrypt), and
+     * the reserve. For the install step pass downloadedBytes == packageSize.
+     */
+    fun bytesNeeded(packageSize: Long, downloadedBytes: Long, encrypted: Boolean): Long =
+        (packageSize - downloadedBytes).coerceAtLeast(0) +
+                (if (encrypted) packageSize else 0) +
+                RESERVE_BYTES
+
+    /**
+     * Rule 5 for the moment of installing (device idle is a job constraint). Returns the reason
+     * for waiting, or null when it may install now.
+     */
+    fun waitReason(
+        screenOn: Boolean,
+        charging: Boolean,
+        night: Boolean,
+        batteryLevelOk: Boolean,
+    ): String? = when {
+        screenOn -> "screen is on"
+        !charging && !night -> "not charging and outside the night window"
+        !batteryLevelOk -> "battery level too low"
+        else -> null
+    }
+}
