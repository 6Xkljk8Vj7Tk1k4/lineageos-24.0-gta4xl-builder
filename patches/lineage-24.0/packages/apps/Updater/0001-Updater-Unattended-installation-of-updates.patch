@@ -0,0 +1,250 @@
+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.updater.autoinstall
+
+import android.content.Context
+import android.content.Intent
+import android.os.PowerManager
+import android.util.Log
+import androidx.preference.PreferenceManager
+import androidx.work.Constraints
+import androidx.work.ExistingWorkPolicy
+import androidx.work.NetworkType
+import androidx.work.OneTimeWorkRequestBuilder
+import androidx.work.WorkManager
+import androidx.work.workDataOf
+import org.lineageos.updater.controller.UpdaterController
+import org.lineageos.updater.controller.UpdaterService
+import org.lineageos.updater.data.Update
+import org.lineageos.updater.data.UpdateStatus
+import org.lineageos.updater.data.source.local.UpdatesDatabase
+import org.lineageos.updater.data.source.local.UpdatesLocalDataSource
+import org.lineageos.updater.deviceinfo.DeviceInfoUtils
+import org.lineageos.updater.updatescheck.UpdatesCheckWorker
+import org.lineageos.updater.util.InstallUtils
+import java.time.Duration
+import java.time.LocalDateTime
+
+/**
+ * Unattended installation of updates (non-A/B only), off unless the system property
+ * lineage.updater.auto_install is true. The rules are in [AutoInstallPolicy]; this object
+ * connects them to the existing check, download and install code. Every decision is logged
+ * once under [TAG], since the feature has no UI.
+ */
+object AutoInstall {
+    const val TAG = "AutoInstall"
+
+    /** Marks a service intent sent by this feature (UpdaterService goes foreground at once). */
+    const val EXTRA_AUTO = "extra_auto_install"
+
+    private const val PREF_ATTEMPTED_IDS = "auto_install_attempted_ids"
+    private const val PREF_DOWNLOAD_FAILURES = "auto_install_download_failures"
+    private const val WORK_DOWNLOAD = "auto_download"
+    private const val WORK_INSTALL_CHARGING = "auto_install_charging"
+    private const val WORK_INSTALL_NIGHT = "auto_install_night"
+    const val KEY_NIGHT = "night"
+
+    private val WAKE_LOCK_TIMEOUT: Duration = Duration.ofMinutes(15)
+
+    /** Serializes the workers' check-then-act sequences (they run in this process). */
+    internal val lock = Any()
+
+    /** Kept referenced so the wake lock is not released by finalization before its timeout. */
+    private var wakeLock: PowerManager.WakeLock? = null
+
+    @JvmStatic
+    val isEnabled: Boolean
+        get() = AutoInstallPolicy.isEnabled(
+            DeviceInfoUtils.isAutoInstallEnabled, DeviceInfoUtils.isABDevice
+        )
+
+    @JvmStatic
+    fun isAutoIntent(intent: Intent?) = intent?.getBooleanExtra(EXTRA_AUTO, false) == true
+
+    /** BOOT_COMPLETED: check for updates once. */
+    @JvmStatic
+    fun onBoot(context: Context) {
+        if (!isEnabled) return
+        Log.i(TAG, "Boot: scheduling an update check")
+        UpdatesCheckWorker.scheduleOneshotCheck(context)
+    }
+
+    /** A check fetched the server's list: look for something to download. */
+    fun onCheckFinished(context: Context) {
+        if (!isEnabled) return
+        setDownloadFailures(context, 0)
+        Log.i(TAG, "Check finished: scheduling the download step")
+        enqueueDownload(context, Duration.ZERO)
+    }
+
+    /**
+     * Status changes seen by UpdaterService, for the candidate only. Who started the download
+     * does not matter: a candidate downloaded by hand is handled the same way.
+     */
+    @JvmStatic
+    fun onStatusChange(context: Context, update: Update?) {
+        if (!isEnabled || update == null) return
+        val status = update.status
+        if (status != UpdateStatus.VERIFIED && status != UpdateStatus.PAUSED_ERROR &&
+                status != UpdateStatus.VERIFICATION_FAILED) return
+        val candidate = candidate(context, UpdaterController.getInstance(context)).update
+        if (candidate?.downloadId != update.downloadId) return
+        when (status) {
+            UpdateStatus.VERIFIED -> {
+                setDownloadFailures(context, 0)
+                Log.i(TAG, "${update.name} verified: scheduling the install")
+                enqueueInstall(context)
+            }
+            UpdateStatus.PAUSED_ERROR -> {
+                val failures = downloadFailures(context) + 1
+                setDownloadFailures(context, failures)
+                val delay = AutoInstallPolicy.downloadRetryDelay(failures)
+                if (delay != null) {
+                    Log.i(TAG, "Download of ${update.name} failed ($failures): retrying in $delay")
+                    enqueueDownload(context, delay)
+                } else {
+                    Log.i(TAG, "Download of ${update.name} failed ($failures): waiting for the next check")
+                }
+            }
+            else -> {
+                rememberAttempt(context, update.downloadId)
+                Log.i(TAG, "${update.name} failed verification: not trying it again automatically")
+                cancelInstall(context)
+            }
+        }
+    }
+
+    /** The newest eligible update if it may be installed automatically, else the reason. */
+    fun candidate(context: Context, controller: UpdaterController): AutoInstallPolicy.Pick {
+        val pick = AutoInstallPolicy.pickCandidate(
+            controller.updates, DeviceInfoUtils.buildDateTimestamp, DeviceInfoUtils.sdkLevel,
+            attemptedIds(context),
+        )
+        val update = pick.update ?: return pick
+        return if (InstallUtils.canInstall(update)) {
+            pick
+        } else {
+            AutoInstallPolicy.Pick(null, "${update.name} is blocked by InstallUtils")
+        }
+    }
+
+    /**
+     * Hands the database's updates to the controller, as UpdatesActivity does: without an
+     * activity the controller may not know them yet (it also loads the database
+     * asynchronously right after process start).
+     */
+    fun syncController(context: Context): UpdaterController {
+        val controller = UpdaterController.getInstance(context)
+        val updates =
+            UpdatesLocalDataSource(UpdatesDatabase.getInstance(context).updateDao()).getUpdates()
+        val onlineIds = mutableListOf<String>()
+        for (update in updates) {
+            val online = update.downloadId != Update.LOCAL_ID
+            controller.addUpdate(update, online)
+            if (online) onlineIds.add(update.downloadId)
+        }
+        controller.setUpdatesAvailableOnline(onlineIds, true)
+        return controller
+    }
+
+    private fun prefs(context: Context) = PreferenceManager.getDefaultSharedPreferences(context)
+
+    private fun attemptedIds(context: Context): Set<String> =
+        prefs(context).getStringSet(PREF_ATTEMPTED_IDS, null) ?: emptySet()
+
+    /** Rule 4: written synchronously (a new set, commit()), before anything is triggered. */
+    fun rememberAttempt(context: Context, downloadId: String): Boolean =
+        prefs(context).edit()
+            .putStringSet(PREF_ATTEMPTED_IDS, HashSet(attemptedIds(context)) + downloadId)
+            .commit()
+
+    private fun downloadFailures(context: Context) =
+        prefs(context).getInt(PREF_DOWNLOAD_FAILURES, 0)
+
+    private fun setDownloadFailures(context: Context, failures: Int) {
+        prefs(context).edit().putInt(PREF_DOWNLOAD_FAILURES, failures).commit()
+    }
+
+    fun enqueueDownload(context: Context, delay: Duration) {
+        val request = OneTimeWorkRequestBuilder<AutoDownloadWorker>()
+            .setConstraints(
+                Constraints.Builder().setRequiredNetworkType(NetworkType.UNMETERED).build()
+            )
+            .setInitialDelay(delay)
+            .build()
+        WorkManager.getInstance(context)
+            .enqueueUniqueWork(WORK_DOWNLOAD, ExistingWorkPolicy.REPLACE, request)
+    }
+
+    fun enqueueInstall(context: Context) {
+        val request = OneTimeWorkRequestBuilder<AutoInstallWorker>()
+            .setConstraints(
+                Constraints.Builder().setRequiresDeviceIdle(true).setRequiresCharging(true).build()
+            )
+            .build()
+        WorkManager.getInstance(context)
+            .enqueueUniqueWork(WORK_INSTALL_CHARGING, ExistingWorkPolicy.KEEP, request)
+        enqueueNightInstall(context, ExistingWorkPolicy.KEEP)
+    }
+
+    fun enqueueNightInstall(context: Context, policy: ExistingWorkPolicy) {
+        val request = OneTimeWorkRequestBuilder<AutoInstallWorker>()
+            .setConstraints(Constraints.Builder().setRequiresDeviceIdle(true).build())
+            .setInitialDelay(AutoInstallPolicy.delayToNight(LocalDateTime.now()))
+            .setInputData(workDataOf(KEY_NIGHT to true))
+            .build()
+        WorkManager.getInstance(context).enqueueUniqueWork(WORK_INSTALL_NIGHT, policy, request)
+    }
+
+    fun cancelInstall(context: Context) {
+        val workManager = WorkManager.getInstance(context)
+        workManager.cancelUniqueWork(WORK_INSTALL_CHARGING)
+        workManager.cancelUniqueWork(WORK_INSTALL_NIGHT)
+    }
+
+    /** Download through UpdaterService, which runs it in the foreground with its wake lock. */
+    fun startDownload(context: Context, downloadId: String) = startService(
+        context,
+        Intent(context, UpdaterService::class.java)
+            .setAction(UpdaterService.ACTION_DOWNLOAD_CONTROL)
+            .putExtra(UpdaterService.EXTRA_DOWNLOAD_ID, downloadId)
+            .putExtra(UpdaterService.EXTRA_DOWNLOAD_CONTROL, UpdaterService.DOWNLOAD_START)
+            .putExtra(EXTRA_AUTO, true),
+    )
+
+    /** The intent of Utils.triggerUpdate(), sent as a foreground service start. */
+    fun startInstall(context: Context, downloadId: String) = startService(
+        context,
+        Intent(context, UpdaterService::class.java)
+            .setAction(UpdaterService.ACTION_INSTALL_UPDATE)
+            .putExtra(UpdaterService.EXTRA_DOWNLOAD_ID, downloadId)
+            .putExtra(EXTRA_AUTO, true),
+    )
+
+    /** False (and logged) when the system refuses the start. */
+    private fun startService(context: Context, intent: Intent): Boolean = try {
+        context.startForegroundService(intent)
+        true
+    } catch (e: Exception) {
+        Log.i(TAG, "Could not start UpdaterService for ${intent.action}: $e")
+        false
+    }
+
+    /** Rule 8: keep the CPU awake for the copy and uncrypt until the reboot. */
+    fun holdWakeLock(context: Context) {
+        val powerManager = context.getSystemService(PowerManager::class.java)
+        wakeLock = powerManager.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Updater:autoInstall")
+            .apply {
+                setReferenceCounted(false)
+                acquire(WAKE_LOCK_TIMEOUT.toMillis())
+            }
+    }
+
+    fun releaseWakeLock() {
+        wakeLock?.takeIf { it.isHeld }?.release()
+        wakeLock = null
+    }
+}
