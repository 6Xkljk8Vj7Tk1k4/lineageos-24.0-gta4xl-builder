+/*
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.updater.autoinstall
+
+import android.content.Context
+import android.os.PowerManager
+import android.util.Log
+import androidx.work.CoroutineWorker
+import androidx.work.ExistingWorkPolicy
+import androidx.work.WorkerParameters
+import org.lineageos.updater.UpdaterApplication
+import org.lineageos.updater.deviceinfo.DeviceInfoUtils
+import org.lineageos.updater.misc.Utils
+import org.lineageos.updater.util.OtaMetadataParser
+import java.time.LocalDateTime
+
+/** Starts or resumes the download of the candidate (enqueued with an unmetered network). */
+class AutoDownloadWorker(
+    context: Context,
+    params: WorkerParameters,
+) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result {
+        if (!AutoInstall.isEnabled) return Result.success()
+        val context = applicationContext
+        synchronized(AutoInstall.lock) {
+            val controller = AutoInstall.syncController(context)
+            if (controller.isBusy) {
+                Log.i(TAG, "Download step: skipped, a download, verification or install is running")
+                return Result.success()
+            }
+            val pick = AutoInstall.candidate(context, controller)
+            val update = pick.update
+            if (update == null) {
+                Log.i(TAG, "Download step: nothing to do, ${pick.reason}")
+                AutoInstall.cancelInstall(context)
+                return Result.success()
+            }
+            if (update.hasVerifiedPackage()) {
+                Log.i(TAG, "Download step: ${update.name} is verified already, scheduling the install")
+                AutoInstall.enqueueInstall(context)
+                return Result.success()
+            }
+            val downloadDir = Utils.getDownloadPath(context)
+            val downloaded = update.file?.takeIf { it.exists() }?.length() ?: 0L
+            val needed = AutoInstallPolicy.bytesNeeded(
+                update.fileSize, downloaded, Utils.isEncrypted(context, downloadDir)
+            )
+            val free = downloadDir.usableSpace
+            if (free < needed) {
+                Log.i(TAG, "Download step: ${update.name} skipped, $free bytes free, $needed needed")
+                return Result.success()
+            }
+            Log.i(TAG, "Download step: downloading ${update.name} ($downloaded bytes present)")
+            AutoInstall.startDownload(context, update.downloadId)
+        }
+        return Result.success()
+    }
+
+    private companion object {
+        const val TAG = AutoInstall.TAG
+    }
+}
+
+/**
+ * Installs the verified candidate. Enqueued twice: with device idle + charging, and with
+ * device idle delayed to the night window ([AutoInstall.KEY_NIGHT]).
+ */
+class AutoInstallWorker(
+    context: Context,
+    params: WorkerParameters,
+) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result {
+        if (!AutoInstall.isEnabled) return Result.success()
+        val context = applicationContext
+        val night = inputData.getBoolean(AutoInstall.KEY_NIGHT, false)
+        val step = if (night) "Night install" else "Install while charging"
+        synchronized(AutoInstall.lock) {
+            val controller = AutoInstall.syncController(context)
+            if (controller.isBusy) {
+                Log.i(TAG, "$step: waiting, a download, verification or install is running")
+                return later(context, night)
+            }
+            val pick = AutoInstall.candidate(context, controller)
+            val update = pick.update
+            val file = update?.file
+            if (update == null) {
+                Log.i(TAG, "$step: nothing to do, ${pick.reason}")
+                AutoInstall.cancelInstall(context)
+                return Result.success()
+            }
+            if (file == null || !update.hasVerifiedPackage()) {
+                Log.i(TAG, "$step: nothing to do, ${update.name} is not downloaded and verified")
+                AutoInstall.cancelInstall(context)
+                return Result.success()
+            }
+
+            // The index JSON is unsigned: decide on the verified package's own metadata.
+            val refusal = try {
+                val metadata = OtaMetadataParser(file)
+                AutoInstallPolicy.refuseByMetadata(
+                    metadata.timestamp, metadata.sdkLevel, metadata.isABUpdate,
+                    DeviceInfoUtils.buildDateTimestamp, DeviceInfoUtils.sdkLevel,
+                )
+            } catch (e: Exception) {
+                "cannot read the package metadata ($e)"
+            }
+            if (refusal != null) {
+                AutoInstall.rememberAttempt(context, update.downloadId)
+                Log.i(TAG, "$step: not installing ${update.name}: $refusal")
+                AutoInstall.cancelInstall(context)
+                return Result.success()
+            }
+
+            val battery = (context as UpdaterApplication).batteryMonitor.currentBatteryState
+            val wait = AutoInstallPolicy.waitReason(
+                screenOn = context.getSystemService(PowerManager::class.java).isInteractive,
+                charging = battery.isCharging,
+                night = AutoInstallPolicy.isNight(LocalDateTime.now().hour),
+                batteryLevelOk = battery.isLevelOk,
+            )
+            if (wait != null) {
+                Log.i(TAG, "$step: waiting, $wait (battery ${battery.level} %)")
+                return later(context, night)
+            }
+
+            val needed = AutoInstallPolicy.bytesNeeded(
+                file.length(), file.length(), Utils.isEncrypted(context, file)
+            )
+            val free = file.parentFile?.usableSpace ?: 0L
+            if (free < needed) {
+                Log.i(TAG, "$step: waiting, $free bytes free, $needed needed")
+                return later(context, night)
+            }
+
+            if (!AutoInstall.rememberAttempt(context, update.downloadId)) {
+                Log.i(TAG, "$step: could not store the attempt, not installing")
+                return later(context, night)
+            }
+            AutoInstall.holdWakeLock(context)
+            Log.i(TAG, "$step: installing ${update.name}")
+            if (!AutoInstall.startInstall(context, update.downloadId)) {
+                // The attempt stays recorded: no retry loop, the log line above says why.
+                AutoInstall.releaseWakeLock()
+            }
+        }
+        return Result.success()
+    }
+
+    /** Transient "not now": again at the next idle window, or at the next night. */
+    private fun later(context: Context, night: Boolean): Result {
+        if (night && !AutoInstallPolicy.isNight(LocalDateTime.now().hour)) {
+            AutoInstall.enqueueNightInstall(context, ExistingWorkPolicy.REPLACE)
+            return Result.success()
+        }
+        return Result.retry()
+    }
+
+    private companion object {
+        const val TAG = AutoInstall.TAG
+    }
+}
